# Cloudflare R2 (server-only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Public bucket custom domain or R2.dev URL, without a trailing slash.
R2_PUBLIC_URL=https://media.example.com

# Public CDN base URL used by frontend images and videos, without a trailing slash.
NEXT_PUBLIC_CDN_URL=https://cdn.example.com

# Mux public playback ID for the homepage hero (not the asset ID).
NEXT_PUBLIC_MUX_HERO_PLAYBACK_ID=

# Sanity CMS (public, non-secret identifiers)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-27
